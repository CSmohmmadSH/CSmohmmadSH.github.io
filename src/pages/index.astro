---
import Base from '../layouts/Base.astro';
import Background from '../components/Background.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import Stack from '../components/Stack.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
---
<Base
  title="Mohammed Alshaqaq — Cloud & Kubernetes Engineer"
  description="Cloud and DevOps engineer building Kubernetes platforms on AWS: GitOps delivery with ArgoCD, progressive rollouts with Istio, and observability with Prometheus and Grafana."
>
  <Background />
  <div class="content">
    <Header />
    <main class="main">
      <Hero />
      <Work />
      <Stack />
      <About />
      <Contact />
    </main>
  </div>
</Base>
